# shellcheck disable=SC1090,SC1091
shopt -s nullglob

# XDG base directories — must be set before sourcing sh/profile/
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# Source shared profile configs (exports, env vars)
for file in "$XDG_CONFIG_HOME/sh/profile/"*.sh; do
  [ -f "$file" ] && source "$file"
done

# Machine-local profile overrides, sourced last so they win.  Not in the repo.
for file in "$XDG_CONFIG_HOME/local/profile/"*.sh; do
  [ -f "$file" ] && source "$file"
done

# Chain to .bashrc for interactive login shells
[[ -f ~/.bashrc ]] && source ~/.bashrc
